# Puerto del servidor (Render asigna el suyo automáticamente)
PORT=10000

# URL de conexión a PostgreSQL (proporcionada por Render)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secreto para firmar tokens JWT (generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=tu_secreto_aqui

# Usuarios autorizados — formato: usuario1:bcryptHash1,usuario2:bcryptHash2
# Generar hash con: node -e "require('bcryptjs').hash('tu_password', 10).then(h => console.log(h))"
# Ejemplo (password "mipass123"):
# AUTH_USERS=tony:$2b$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AUTH_USERS=

# ── Webhook email inbound (SendGrid Inbound Parse) ──────────────────────────

# Clave secreta para verificar que el webhook viene de SendGrid.
# Añadir como query param en la URL del webhook: /webhooks/email?secret=VALOR
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=

# API Key de SendGrid para enviar emails de confirmación.
# Crear en: SendGrid → Settings → API Keys → Create API Key → Mail Send (restricted)
SENDGRID_API_KEY=

# Dirección verificada en SendGrid desde la que se envían las confirmaciones.
# Verificar en: SendGrid → Settings → Sender Authentication → Single Sender Verification
SENDGRID_FROM_EMAIL=

# Dirección de email asignada por SendGrid Inbound Parse (solo documentación).
# Configurar en: SendGrid → Settings → Inbound Parse → Add Host & URL
SENDGRID_INBOUND_EMAIL=
