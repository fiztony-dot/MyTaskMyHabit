# Backend URL (Cloudflare Worker) — opcional, el fallback está en client.js
VITE_BACKEND_URL=https://mytaskmyhabit-worker.fiztony.workers.dev

# Supabase – necesario para Realtime (actualización automática de tareas)
# Obtén estos valores en: Supabase → Settings → API
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=<tu-anon-key>
